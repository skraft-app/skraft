<?xml version="1.0" encoding="UTF-8"?>
<!-- The .skraft documents' MIME type (shared-mime-info), installed in the AppImage beside the
     .desktop entry that opens them (scripts/package-linux.sh). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-skraft">
    <comment>Skraft document</comment>
    <sub-class-of type="application/zip"/>
    <icon name="skraft"/>
    <glob pattern="*.skraft"/>
  </mime-type>
  <mime-type type="application/x-skraft-materials">
    <comment>Skraft materials</comment>
    <sub-class-of type="application/zip"/>
    <icon name="skraft"/>
    <glob pattern="*.skraftmat"/>
  </mime-type>
</mime-info>
