<!--
  The Windows installer (WiX 5, scripts/package-windows.sh): Skraft in Program Files, a
  Start menu shortcut, an entry in Apps & features, the .skraft documents opened with it (a
  double click starts the app with the file as its argument, src/opened.rs), its license and
  the third-party notices beside it. A newer version replaces the installed one.
  Its wizard, in English: Welcome, Ready to install, the progress, Finish, on Skraft's pictures
  (dialog.bmp 493 x 312, its left 164 px shown; banner.bmp 493 x 58). No license to accept:
  the GPL asks none to install, and LICENSE.txt is installed beside the app. WixUI_InstallDir
  with its Next and Back rerouted past the license and folder pages, as WiX documents; repair
  and removal keep its pages.
  Variables: Version (x.y.z), ExeFile, IconFile, LicenseFile, NoticesFile, DialogBmp, BannerBmp.
  The UpgradeCode identifies the product across versions: never change it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Skraft" Manufacturer="L'Air du Bois" Version="$(Version)" UpgradeCode="056EB52C-EBAB-4A03-BC5D-A5CD57A747C7" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Skraft is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="99" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" Condition="NOT Installed" />
    </UI>
    <WixVariable Id="WixUIDialogBmp" Value="$(DialogBmp)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(BannerBmp)" />

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Skraft">
        <Component>
          <File Id="SkraftExe" Source="$(ExeFile)" Name="skraft.exe" KeyPath="yes">
            <Shortcut Name="Skraft" Directory="ProgramMenuFolder" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Advertise="no" />
          </File>
          <ProgId Id="Skraft.Document" Description="Skraft Document" Icon="SkraftExe" IconIndex="0" Advertise="no">
            <Extension Id="skraft" ContentType="application/x-skraft">
              <Verb Id="open" TargetFile="SkraftExe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
          <ProgId Id="Skraft.Materials" Description="Skraft Materials" Icon="SkraftExe" IconIndex="0" Advertise="no">
            <Extension Id="skraftmat" ContentType="application/x-skraft-materials">
              <Verb Id="open" TargetFile="SkraftExe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        </Component>
        <Component>
          <File Id="License" Source="$(LicenseFile)" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component>
          <File Id="Notices" Source="$(NoticesFile)" Name="THIRD-PARTY-LICENSES.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
