ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('hand-written assembly: a board placed twice in a cabinet'),'2;1');
FILE_NAME('assembly','2026-11-12T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
/* units (cm, to check the placements are scaled too) and context */
#1=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.CENTI.,.METRE.));
#2=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#3=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2))REPRESENTATION_CONTEXT('',''));
#10=CARTESIAN_POINT('',(0.,0.,0.));
#11=DIRECTION('',(0.,0.,1.));
#12=DIRECTION('',(1.,0.,0.));
#13=AXIS2_PLACEMENT_3D('',#10,#11,#12);
/* the board: 60 x 30 x 1.8 cm, faceted */
#20=CARTESIAN_POINT('',(0.,0.,0.));
#21=CARTESIAN_POINT('',(60.,0.,0.));
#22=CARTESIAN_POINT('',(0.,30.,0.));
#23=CARTESIAN_POINT('',(60.,30.,0.));
#24=CARTESIAN_POINT('',(0.,0.,1.8));
#25=CARTESIAN_POINT('',(60.,0.,1.8));
#26=CARTESIAN_POINT('',(0.,30.,1.8));
#27=CARTESIAN_POINT('',(60.,30.,1.8));
#30=POLY_LOOP('',(#20,#22,#23,#21));
#31=POLY_LOOP('',(#24,#25,#27,#26));
#32=POLY_LOOP('',(#20,#21,#25,#24));
#33=POLY_LOOP('',(#22,#26,#27,#23));
#34=POLY_LOOP('',(#20,#24,#26,#22));
#35=POLY_LOOP('',(#21,#23,#27,#25));
#40=FACE_OUTER_BOUND('',#30,.T.);
#41=FACE_OUTER_BOUND('',#31,.T.);
#42=FACE_OUTER_BOUND('',#32,.T.);
#43=FACE_OUTER_BOUND('',#33,.T.);
#44=FACE_OUTER_BOUND('',#34,.T.);
#45=FACE_OUTER_BOUND('',#35,.T.);
#50=FACE('',(#40));
#51=FACE('',(#41));
#52=FACE('',(#42));
#53=FACE('',(#43));
#54=FACE('',(#44));
#55=FACE('',(#45));
#60=CLOSED_SHELL('',(#50,#51,#52,#53,#54,#55));
#61=FACETED_BREP('Board',#60);
#62=FACETED_BREP_SHAPE_REPRESENTATION('',(#61,#13),#3);
/* products */
#100=APPLICATION_CONTEXT('automotive design');
#101=PRODUCT_CONTEXT('',#100,'mechanical');
#102=PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');
#110=PRODUCT('board','Planche \X2\00E9\X0\','',(#101));
#111=PRODUCT_DEFINITION_FORMATION('','',#110);
#112=PRODUCT_DEFINITION('design','',#111,#102);
#113=PRODUCT_DEFINITION_SHAPE('','',#112);
#114=SHAPE_REPRESENTATION('',(#13),#3);
#115=SHAPE_DEFINITION_REPRESENTATION(#113,#114);
#116=SHAPE_REPRESENTATION_RELATIONSHIP('','',#114,#62);
#120=PRODUCT('cabinet','Caisson','',(#101));
#121=PRODUCT_DEFINITION_FORMATION('','',#120);
#122=PRODUCT_DEFINITION('design','',#121,#102);
#123=PRODUCT_DEFINITION_SHAPE('','',#122);
#124=SHAPE_REPRESENTATION('',(#13,#131,#141,#164),#3);
#125=SHAPE_DEFINITION_REPRESENTATION(#123,#124);
/* "Bas" at the origin */
#130=CARTESIAN_POINT('',(0.,0.,0.));
#131=AXIS2_PLACEMENT_3D('',#130,#11,#12);
#132=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','Bas','',#122,#112,$);
#133=PRODUCT_DEFINITION_SHAPE('','',#132);
#134=ITEM_DEFINED_TRANSFORMATION('','',#13,#131);
#135=(REPRESENTATION_RELATIONSHIP('','',#114,#124)REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#134)SHAPE_REPRESENTATION_RELATIONSHIP());
#136=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#135,#133);
/* "Haut" 50 cm up, turned a quarter about Z */
#140=CARTESIAN_POINT('',(0.,0.,50.));
#142=DIRECTION('',(0.,1.,0.));
#141=AXIS2_PLACEMENT_3D('',#140,#11,#142);
#143=NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','Haut','',#122,#112,$);
#144=PRODUCT_DEFINITION_SHAPE('','',#143);
#145=ITEM_DEFINED_TRANSFORMATION('','',#13,#141);
#146=(REPRESENTATION_RELATIONSHIP('','',#114,#124)REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#145)SHAPE_REPRESENTATION_RELATIONSHIP());
#147=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#146,#144);
/* the board's colour */
#150=COLOUR_RGB('',0.8,0.6,0.4);
#151=FILL_AREA_STYLE_COLOUR('',#150);
#152=FILL_AREA_STYLE('',(#151));
#153=SURFACE_STYLE_FILL_AREA(#152);
#154=SURFACE_SIDE_STYLE('',(#153));
#155=SURFACE_STYLE_USAGE(.BOTH.,#154);
#156=PRESENTATION_STYLE_ASSIGNMENT((#155));
#157=STYLED_ITEM('color',(#156),#61);
#158=MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION('',(#157),#3);
/* a sheet in the cabinet: open, excluded */
#160=POLY_LOOP('',(#20,#21,#24));
#161=FACE_OUTER_BOUND('',#160,.T.);
#162=FACE('',(#161));
#163=OPEN_SHELL('',(#162));
#164=SHELL_BASED_SURFACE_MODEL('Sheet',(#163));
ENDSEC;
END-ISO-10303-21;
